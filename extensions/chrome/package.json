{
  "name": "audio-minutes-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Google Meet タブの音声を audio-minutes GUI へ渡す Chrome 連携拡張 (MV3)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && node build.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
