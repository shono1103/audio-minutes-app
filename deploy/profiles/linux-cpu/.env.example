# linux-cpu (将来の Linux リモート配置)。明示指定時のみ。Caddy が 443 で TLS 終端し minutes-api だけを公開する。
AM_PROFILE=linux-cpu
COMPOSE_PROFILES=cpu
AM_IMAGE_TAG=0.1.0
AM_LOG_LEVEL=info

# API は loopback bind のまま。Caddy (同一ホスト) が reverse_proxy する
AM_API_PORT=8787
AM_PUBLIC_BASE_URL=https://minutes.example.internal
AM_RP_ID=minutes.example.internal
AM_ALLOWED_ORIGINS=https://minutes.example.internal

AM_API_DB_PASSWORD=
AM_WORKER_DB_PASSWORD=
AM_SECRET_KEY=
AM_INTERNAL_TOKEN=

AM_RETENTION_UPLOAD_HOURS=24
AM_RETENTION_AUDIO_DAYS=30
AM_RETENTION_LOG_DAYS=14
AM_MAX_AUDIO_MS=14400000
AM_MAX_UPLOAD_BYTES=2147483648

AM_ENGINE=faster-whisper
AM_STRATEGY=vad_turbo
AM_THREADS=4
AM_WORKER_CPUS=4
AM_WORKER_MEMORY=8g
HF_HUB_OFFLINE=1
AM_MODEL_MIN_FREE_BYTES=8589934592
AM_MODEL_JA=kotoba-tech/kotoba-whisper-v2.0-faster
AM_MODEL_JA_REVISION=f44edd35eaeb2274e85ac7b31fb2c6f59ff1c4bc
AM_MODEL_MULTILINGUAL=dropbox-dash/faster-whisper-large-v3-turbo
AM_MODEL_MULTILINGUAL_REVISION=0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf

# リモート配置での Claude subscription 認証は利用条件の再確認後に有効化する (claude-auth.md)
AM_CLAUDE_BIN=claude
AM_CLAUDE_MODEL=
AM_CLAUDE_MOCK=0
