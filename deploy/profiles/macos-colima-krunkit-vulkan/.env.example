# macos-colima-krunkit-vulkan (明示指定時のみ)。別 Colima profile `audio-minutes-gpu-eval` 上で使う。
# 既存 default (vz) の VM・volume・context は変更しない。Compose project 名・ポートも CPU 配置と分ける。
AM_PROFILE=macos-colima-krunkit-vulkan
COMPOSE_PROFILES=gpu
AM_IMAGE_TAG=0.1.0
AM_LOG_LEVEL=info

AM_API_PORT=8797
AM_PUBLIC_BASE_URL=http://localhost:8797
AM_RP_ID=localhost  # AM_PUBLIC_BASE_URL の host と一致させる (WebAuthn RP ID)
AM_ALLOWED_ORIGINS=http://localhost:8797

AM_API_DB_PASSWORD=
AM_WORKER_DB_PASSWORD=
AM_SECRET_KEY=
AM_INTERNAL_TOKEN=

AM_RETENTION_UPLOAD_HOURS=24
AM_RETENTION_AUDIO_DAYS=30
AM_RETENTION_LOG_DAYS=14
AM_MAX_AUDIO_MS=14400000
AM_MAX_UPLOAD_BYTES=2147483648

# 文字起こし (whisper.cpp Vulkan)。GPU 初期化・実利用の検証に失敗したら gpu_unavailable で停止する
AM_ENGINE=whisper.cpp
AM_STRATEGY=vad_turbo
AM_THREADS=4
AM_WORKER_CPUS=4
AM_WORKER_MEMORY=8g
HF_HUB_OFFLINE=1
AM_MODEL_JA=kotoba-tech/kotoba-whisper-v2.0-faster
AM_MODEL_JA_REVISION=f44edd35eaeb2274e85ac7b31fb2c6f59ff1c4bc
AM_MODEL_MULTILINGUAL=dropbox-dash/faster-whisper-large-v3-turbo
AM_MODEL_MULTILINGUAL_REVISION=0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf
# GPU 評価 run では 0 のまま。運用で CPU 再試行を許可する場合だけ 1 (別 attempt で最大 1 回)
AM_GPU_CPU_FALLBACK=0
# ゲスト内の render device グループ。scripts/install.sh が `stat -c %g /dev/dri/renderD128` で検出して埋める
AM_RENDER_GID=video

AM_CLAUDE_BIN=claude
AM_CLAUDE_MODEL=
AM_CLAUDE_MOCK=0
