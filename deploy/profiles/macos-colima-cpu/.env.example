# macos-colima-cpu (既定 profile)。scripts/install.sh がこの雛形から .env を生成し、秘密を乱数で埋める。
# 既存の .env は上書きしない。値を変えたら `scripts/service.sh restart` で container を再生成する。
AM_PROFILE=macos-colima-cpu
COMPOSE_PROFILES=cpu
AM_IMAGE_TAG=0.1.0
AM_LOG_LEVEL=info
AM_DOCKER_CONTEXT=colima-audio-minutes-cpu
AM_COLIMA_PROFILE=audio-minutes-cpu

# 公開 (loopback のみ)。
# ブラウザー認証 (パスキー) の canonical origin は AM_PUBLIC_BASE_URL で、
# その host と AM_RP_ID・AM_ALLOWED_ORIGINS を必ず一致させる。WebAuthn の RP ID は
# ドメイン文字列なので IP (127.0.0.1) は使えない。localhost を正とし、認証画面・
# upload URL・same-origin 検査をすべて同じ origin に揃える。
AM_API_PORT=8787
AM_PUBLIC_BASE_URL=http://localhost:8787
AM_RP_ID=localhost
AM_ALLOWED_ORIGINS=http://localhost:8787

# 秘密 (install.sh が openssl rand で生成する)
AM_API_DB_PASSWORD=
AM_WORKER_DB_PASSWORD=
AM_SECRET_KEY=
AM_INTERNAL_TOKEN=

# 保持期間・上限 (owner が API で変更した値が優先)
AM_RETENTION_UPLOAD_HOURS=24
AM_RETENTION_AUDIO_DAYS=30
AM_RETENTION_LOG_DAYS=14
AM_MAX_AUDIO_MS=14400000
AM_MAX_UPLOAD_BYTES=2147483648

# 文字起こし (CPU)。GPU を初期化しない
AM_ENGINE=faster-whisper
AM_STRATEGY=vad_turbo
AM_THREADS=4
AM_WORKER_CPUS=4
AM_WORKER_MEMORY=8g
HF_HUB_OFFLINE=1
AM_MODEL_MIN_FREE_BYTES=8589934592
AM_MODEL_JA=kotoba-tech/kotoba-whisper-v2.0-faster
AM_MODEL_JA_REVISION=f44edd35eaeb2274e85ac7b31fb2c6f59ff1c4bc
AM_MODEL_MULTILINGUAL=dropbox-dash/faster-whisper-large-v3-turbo
AM_MODEL_MULTILINGUAL_REVISION=0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf

# 議事録 (Claude CLI)
AM_CLAUDE_BIN=claude
AM_CLAUDE_MODEL=
AM_CLAUDE_MOCK=0
