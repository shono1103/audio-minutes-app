{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audio-minutes.dev/schemas/recording-package.v2.schema.json",
  "title": "RecordingPackage v2",
  "description": "録音・取り込みクライアントが minutes-api へ渡す録音パッケージのメタデータ。PID やローカルパスなど macOS 固有の情報を処理条件として含めない。v2: 利用者が入力したタイトルと、クライアントが作った仮タイトルを区別する title_edited_by_user を追加した。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "input_kind",
    "time_base",
    "started_at",
    "tracks",
    "source",
    "title_edited_by_user"
  ],
  "properties": {
    "schema_version": {
      "const": "recording-package/2"
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "description": "クライアントが生成するランダム UUID。API 再送の冪等キーになる"
    },
    "input_kind": {
      "enum": [
        "recorded_dual_track",
        "imported_mixed"
      ]
    },
    "time_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "origin"
      ],
      "properties": {
        "unit": {
          "const": "ms",
          "description": "全時刻は録音開始基準の整数ミリ秒。sample_index = round(ms * sample_rate / 1000)"
        },
        "origin": {
          "const": "recording_start"
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "description": "表示用タイトル。利用者未入力のときはクライアントが録音元・ファイル名と日時から仮生成する (FR-107 / FR-141)。仮タイトルか利用者入力かは title_edited_by_user で区別する"
    },
    "language_mode": {
      "enum": [
        "auto",
        "ja",
        "en",
        "mixed"
      ],
      "default": "auto"
    },
    "allow_external_send": {
      "type": "boolean",
      "default": true,
      "description": "false なら「外部送信禁止」。文字起こしまでで停止する"
    },
    "format_profile_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "title_edited_by_user": {
      "type": "boolean",
      "default": false,
      "description": "true なら title は利用者が入力・編集したもの。false ならクライアントの仮タイトルで、議事録生成時に Claude の提案タイトルへ更新してよい (FR-107)"
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "role",
        "start_offset_ms",
        "container",
        "codec",
        "sample_rate",
        "channels",
        "duration_ms",
        "byte_size",
        "sha256"
      ],
      "properties": {
        "track_id": {
          "enum": [
            "app-audio",
            "microphone",
            "imported-audio"
          ]
        },
        "role": {
          "enum": [
            "app",
            "microphone",
            "mixed"
          ],
          "description": "音源の区別であり話者の識別ではない"
        },
        "start_offset_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "共通時刻基準に対するこのトラック先頭のオフセット"
        },
        "container": {
          "enum": [
            "wav",
            "m4a",
            "mp3",
            "flac"
          ]
        },
        "codec": {
          "enum": [
            "pcm_s16le",
            "pcm_s24le",
            "pcm_f32le",
            "aac",
            "mp3",
            "flac"
          ]
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14400000,
          "description": "最長 4 時間"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648,
          "description": "取り込みは最大 2 GiB"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_container": {
          "type": [
            "string",
            "null"
          ],
          "description": "取り込み元の形式 (basename は送らない)"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "app",
            "chrome_tab",
            "file"
          ]
        },
        "app_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Zoom / Microsoft Teams / Google Chrome"
        },
        "bundle_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tab_host": {
          "type": [
            "string",
            "null"
          ],
          "description": "meet.google.com だけ。完全な URL は送らない"
        },
        "client": {
          "type": [
            "string",
            "null"
          ],
          "description": "audio-minutes-gui/0.1.0 等"
        }
      }
    }
  }
}
