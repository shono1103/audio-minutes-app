{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audio-minutes.dev/schemas/job.v1.schema.json",
  "title": "Job v1",
  "description": "永続ジョブ。API が投入し、worker は claim/heartbeat/complete/fail の限定操作だけを使う。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "kind", "session_id", "owner_id", "input", "settings", "idempotency_key", "status", "attempt", "max_attempts", "timeout_seconds", "cancel_requested", "created_at"],
  "properties": {
    "schema_version": { "const": "job/1" },
    "job_id": { "type": "string", "format": "uuid" },
    "kind": { "enum": ["transcription", "minutes_generation"] },
    "session_id": { "type": "string", "format": "uuid" },
    "owner_id": { "type": "string", "format": "uuid" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "kind"],
            "properties": {
              "artifact_id": { "type": "string" },
              "kind": { "enum": ["audio_track", "transcript_json", "minutes_md", "format_snapshot"] },
              "track_id": { "type": ["string", "null"] },
              "role": { "enum": ["app", "microphone", "mixed", null] },
              "start_offset_ms": { "type": ["integer", "null"] },
              "revision": { "type": ["integer", "null"] }
            }
          }
        },
        "transcript_revision": { "type": ["integer", "null"] },
        "parent_minutes_version_id": { "type": ["string", "null"] }
      }
    },
    "settings": {
      "type": "object",
      "description": "投入時点の設定スナップショット。transcription は language_mode/strategy/models/backend、minutes は format_snapshot/instructions/title 状態など",
      "additionalProperties": true
    },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["queued", "leased", "running", "succeeded", "failed", "cancelled"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "max_attempts": { "type": "integer", "minimum": 1 },
    "timeout_seconds": { "type": "integer", "minimum": 1 },
    "cancel_requested": { "type": "boolean" },
    "lease_owner": { "type": ["string", "null"] },
    "lease_expires_at": { "type": ["string", "null"], "format": "date-time" },
    "heartbeat_at": { "type": ["string", "null"], "format": "date-time" },
    "available_at": { "type": ["string", "null"], "format": "date-time", "description": "backoff 後に再取得できる時刻" },
    "result": { "oneOf": [ { "type": "null" }, { "$ref": "worker-result.v1.schema.json" } ] },
    "failure": { "oneOf": [ { "type": "null" }, { "$ref": "error.v1.schema.json#/$defs/job_failure" } ] },
    "created_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
